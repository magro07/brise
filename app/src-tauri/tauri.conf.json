{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brise",
  "version": "0.2.0",
  "identifier": "dev.brise.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brise",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Desktop-Client für KI-Coding-Agenten mit Zusammenarbeit im Team",
    "longDescription": "Desktop-Client für KI-Coding-Agenten (Mistral Vibe, Claude Code, Codex, Gemini CLI) über ACP: geteilte Sessions und Teams mit Ende-zu-Ende-Verschlüsselung, Model Council, eigene Benchmarks, Secrets im Schlüsselbund und Nutzungs- und Leistungsstatistik.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/skills/**/*"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "category": "DeveloperTool",
    "shortDescription": "Desktop-App f\u00fcr Mistral Vibe",
    "longDescription": "Brise ist eine inoffizielle Desktop-Oberfl\u00e4che f\u00fcr den Coding-Agenten Mistral Vibe.",
    "copyright": "Apache-2.0",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
